FROM ghcr.io/duartesantos8/opengym-api:1.4.1@sha256:4bc07fe7d1f05a57c0fa25da3563d54dfe27223506637d67fc64088a2a2f140b AS upstream
FROM python:3.13-slim@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f AS patch
WORKDIR /patch
COPY adapters/patch_opengym.py adapters/opengym-server.sha256 ./
COPY --from=upstream /app/server.js /patch/server.js
RUN python patch_opengym.py /patch/server.js

FROM upstream
COPY --from=patch /patch/server.js /app/server.js
COPY adapters/aurora-sso.js /app/aurora-sso.js
