* text=auto
*.php text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

*.py text eol=lf
*.conf text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.example text eol=lf
/docker/server/octoprint/root/etc/cont-init.d/* text eol=lf
/docker/server/octoprint/root/etc/services.d/*/run text eol=lf

# Unified patch context lines legitimately contain a single space.
/docker/server/opengym/charts.patch text eol=lf whitespace=-blank-at-eol

# Authentication adapters, Dockerfiles and host units are deployed on Linux.
/docker/server/auth/** text eol=lf
